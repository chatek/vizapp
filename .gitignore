node_modules
/out/
/dist/
/release/
# Remote build collect dir (scripts/release/build-remote.sh writes release-remote/<arch>/).
/release-remote/
/coverage/
playwright-report
test-results
.DS_Store
.env
.env.*
.prime-gui.log
.superdesign/
.claude/worktrees/
__pycache__/
.claude/settings.local.json

# Build artefacts land in build/ (electron-builder's buildResources dir also lives
# there). Never commit a packaged app: build/ holds 290 MB of binaries after a
# release build, and the entitlements plists beside them ARE tracked.
/build/*.dmg
/build/*.zip
/build/*.app
/build/*.exe
/build/*.AppImage
/build/*.deb
/build/*.rpm
/build/*.pacman
/build/*.appx
/build/*.msix
/build/*.blockmap
/build/*.tar
# Staged build input: package.mjs copies the --profile here so electron-builder ships it as
# resources/product.json. Never committed — it is whichever profile this build selected.
product/profile.active.json
# Product seed payload. On this branch the seed content that installs into
# ~/.vizmaster/default (AGENTS.md, templates/, skills/, code/) is AUTHORED repo
# content and MUST be tracked — an ignored payload would ship README-only from a
# fresh clone (estate rule: durable artefacts are tracked). The member integrator
# (contract v2) still writes its bundle into product/payload/ in its build
# snapshot; anything it writes that is not one of the whitelisted authored paths
# stays untracked by the /product/payload/* rule below.
/product/payload/*
!/product/payload/README.md
!/product/payload/AGENTS.md
!/product/payload/templates/
!/product/payload/templates/**
!/product/payload/skills/
!/product/payload/skills/**
!/product/payload/code/
!/product/payload/code/**
!/product/payload/src/
/product/payload/src/*
!/product/payload/src/tools/
!/product/payload/src/tools/**

# packaging mirrors (operator visibility) — never commit these binaries
build/mac-arm64/
build/mac-x64/
build/linux-arm64/
build/linux-x64/
build/win-x64/
build/win-arm64/
