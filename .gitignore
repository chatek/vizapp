node_modules
/out/
/dist/
/release/
/coverage/
playwright-report
test-results
.DS_Store
.env
.env.*
.prime-gui.log
.superdesign/
.claude/worktrees/
__pycache__/
.claude/settings.local.json

# Build artefacts land in build/ (electron-builder's buildResources dir also lives
# there). Never commit a packaged app: build/ holds 290 MB of binaries after a
# release build, and the entitlements plists beside them ARE tracked.
/build/*.dmg
/build/*.zip
/build/*.app
/build/*.exe
/build/*.AppImage
/build/*.blockmap
/build/*.tar
# Staged build input: package.mjs copies the --profile here so electron-builder ships it as
# resources/product.json. Never committed — it is whichever profile this build selected.
product/profile.active.json
